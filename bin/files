#!/usr/bin/env bash
# Left pane: yazi, wired to the preview pane.   Usage: files <run-dir> <start-dir>
RUN="$1"
START="$2"
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# The preview pane reads this to hand focus back to us after editing.
printf '%s\n' "${ZELLIJ_PANE_ID:-}" > "$RUN/files.pane"

export YAZI_CONFIG_HOME="$HERE/yazi" TFINDER_HOME="$HERE" TFINDER_RUN="$RUN"

# zellij can start this command a moment before it sizes the pane, and yazi
# refuses to start in a 0x0 terminal — so wait (up to ~3s) for a real size.
for _ in $(seq 60); do
  read -r rows cols < <(stty size 2>/dev/null) || true
  [ "${rows:-0}" -gt 0 ] && [ "${cols:-0}" -gt 0 ] && break
  sleep 0.05
done

if ! yazi --client-id "$(basename "$RUN")" "$START"; then
  echo
  echo "yazi exited with an error (see above). Press Enter to close the finder."
  read -r _
fi

# yazi quit → tell the preview pane to exit too, so the whole tab closes.
"$HERE/bin/send" quit
